{
  "openapi": "3.0.3",
  "info": {"title": "多货币商品价格体系", "version": "2.0.0", "description": "后台多币种价格、设备币种切换及设备端预留接口。不包含 Flutter 设备端改造。"},
  "servers": [{"url": "{{baseUrl}}"}],
  "tags": [
    {"name": "币种配置"}, {"name": "核心商品多币种"}, {"name": "设备商品多币种"},
    {"name": "货道多币种"}, {"name": "设备币种切换"}, {"name": "设备端币种"}
  ],
  "paths": {
    "/management/currency.currency/getEnabledList": {"post": {"tags": ["币种配置"], "summary": "获取启用币种下拉列表", "security": [{"ManagementToken": []}], "responses": {"200": {"description": "成功", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CurrencyListResponse"}}}}}}},
    "/management/currency.currency/getList": {"post": {"tags": ["币种配置"], "summary": "币种配置列表", "security": [{"ManagementToken": []}], "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"type": "integer", "enum": [1, 2]}, "currency_code": {"type": "string"}}}}}}, "responses": {"200": {"description": "成功"}}}},
    "/management/currency.currency/add": {"post": {"tags": ["币种配置"], "summary": "新增币种", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CurrencyInput"}}}}, "responses": {"200": {"description": "成功"}}}},
    "/management/currency.currency/update": {"post": {"tags": ["币种配置"], "summary": "修改或停用币种", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CurrencyInput"}}}}, "responses": {"200": {"description": "成功；存在引用时不可删除主数据"}}}},
    "/management/currency.currency/getReferences": {"post": {"tags": ["币种配置"], "summary": "获取币种引用统计", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["currency_code"], "properties": {"currency_code": {"type": "string", "example": "HKD"}}}}}}, "responses": {"200": {"description": "成功"}}}},

    "/management/goods.goods/add": {"post": {"tags": ["核心商品多币种"], "summary": "新增核心商品及多币种价格", "description": "新增商品必须包含 CNY 三价；HKD 可同时配置。", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"type": "object", "required": ["g_name", "sku"], "properties": {"g_name": {"type": "string"}, "sku": {"type": "string"}}}, {"$ref": "#/components/schemas/CoreCurrencyPrices"}]}}}}, "responses": {"200": {"description": "成功"}}}},
    "/management/goods.goods/update": {"post": {"tags": ["核心商品多币种"], "summary": "修改核心商品及多币种价格", "description": "不会自动覆盖设备商品或货道价格。", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"type": "object", "required": ["g_id"], "properties": {"g_id": {"type": "integer"}}}, {"$ref": "#/components/schemas/CoreCurrencyPrices"}]}}}}, "responses": {"200": {"description": "成功"}}}},
    "/management/goods.goods/getList": {"post": {"tags": ["核心商品多币种"], "summary": "商品列表（返回 currency_prices）", "security": [{"ManagementToken": []}], "responses": {"200": {"description": "成功"}}}},
    "/management/goods.goods/getFind": {"post": {"tags": ["核心商品多币种"], "summary": "商品详情（返回 currency_prices）", "security": [{"ManagementToken": []}], "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"g_id": {"type": "integer"}}}}}}, "responses": {"200": {"description": "成功"}}}},
    "/management/goods.goods/importExcel": {"post": {"tags": ["核心商品多币种"], "summary": "按标题导入商品及 CNY/HKD 三价", "description": "识别人民币成本价/市场价/零售价、港币成本价/市场价/零售价；g_id 可位于任意列，导出模板置于末列。", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["file_path"], "properties": {"file_path": {"type": "string"}}}}}}, "responses": {"200": {"description": "返回逐行新增/更新统计"}}}},

    "/management/machine.machine_goods/saveCurrencyPrice": {"post": {"tags": ["设备商品多币种"], "summary": "修改设备商品指定币种三价", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"type": "object", "required": ["m_id", "mg_id"], "properties": {"m_id": {"type": "integer"}, "mg_id": {"type": "integer"}}}, {"$ref": "#/components/schemas/CurrencyPriceInput"}]}}}}, "responses": {"200": {"description": "当前币种同时更新旧表快照并递增 currency_version"}}}},
    "/management/machine.machine_goods/synchronizationGoods": {"post": {"tags": ["设备商品多币种"], "summary": "选中设备商品一键同步核心商品币种价", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["m_id", "mg_ids", "currency_code"], "properties": {"m_id": {"type": "integer"}, "mg_ids": {"oneOf": [{"type": "array", "items": {"type": "integer"}}, {"type": "string", "example": "12,13"}]}, "currency_code": {"type": "string", "example": "HKD"}}}}}}, "responses": {"200": {"description": "全选全成或全选全失败"}}}},
    "/management/machine.machine_channel/saveCurrencyPrice": {"post": {"tags": ["货道多币种"], "summary": "修改普通货道指定币种三价", "description": "本期拒绝单货道多商品。", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"type": "object", "required": ["m_id", "mc_id"], "properties": {"m_id": {"type": "integer"}, "mc_id": {"type": "integer"}}}, {"$ref": "#/components/schemas/CurrencyPriceInput"}]}}}}, "responses": {"200": {"description": "成功"}}}},
    "/management/machine.machine_channel/synchronizationMachineGoodsPrice": {"post": {"tags": ["货道多币种"], "summary": "选中货道一键同步设备商品币种价", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["m_id", "mc_ids", "currency_code"], "properties": {"m_id": {"type": "integer"}, "mc_ids": {"oneOf": [{"type": "array", "items": {"type": "integer"}}, {"type": "string", "example": "101,102"}]}, "currency_code": {"type": "string", "example": "HKD"}}}}}}, "responses": {"200": {"description": "全选全成或全选全失败"}}}},

    "/management/machine.machine_config/currencyReadiness": {"post": {"tags": ["设备币种切换"], "summary": "设备币种切换预检", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CurrencySwitchInput"}}}}, "responses": {"200": {"description": "返回 ready、blockers、缺失或串价 ID"}}}},
    "/management/machine.machine_config/switchCurrency": {"post": {"tags": ["设备币种切换"], "summary": "原子切换单台设备币种", "description": "在同一数据库事务中投影设备商品、普通货道三价并更新币种/version。", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CurrencySwitchInput"}}}}, "responses": {"200": {"description": "成功"}, "400": {"description": "存在预检阻断"}}}},
    "/management/machine.machine_config/switchCurrencyBatch": {"post": {"tags": ["设备币种切换"], "summary": "批量逐台切换设备币种", "security": [{"ManagementToken": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["m_ids", "currency_code"], "properties": {"m_ids": {"type": "array", "maxItems": 50, "items": {"type": "integer"}}, "currency_code": {"type": "string", "example": "HKD"}}}}}}, "responses": {"200": {"description": "返回 success/failed 明细，不跨设备做大事务"}}}},

    "/machine/receive/getCurrencySnapshot": {"post": {"tags": ["设备端币种"], "summary": "设备拉取当前完整币种价格快照（预留）", "security": [{"MachineMac": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MachineSignedRequest"}}}}, "responses": {"200": {"description": "返回 currency_code、currency_version、machine_goods、machine_channels"}}}},
    "/machine/receive/reportCurrencySwitchState": {"post": {"tags": ["设备端币种"], "summary": "设备上报币种切换状态（预留）", "security": [{"MachineMac": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/MachineSignedRequest"}, {"type": "object", "required": ["can_switch_currency", "supported_currency_codes"], "properties": {"can_switch_currency": {"type": "integer", "enum": [0, 1]}, "cart_count": {"type": "integer"}, "pending_order_count": {"type": "integer"}, "supported_currency_codes": {"type": "array", "items": {"type": "string"}}, "report_time": {"type": "integer"}}}]}}}}, "responses": {"200": {"description": "状态缓存默认有效 120 秒"}}}},
    "/machine/receive/updateMachineGoodsCurrencyPrice": {"post": {"tags": ["设备端币种"], "summary": "设备修改当前币种设备商品三价（预留）", "security": [{"MachineMac": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/MachineSignedRequest"}, {"type": "object", "required": ["mg_id", "cost_price", "market_price", "retail_price"], "properties": {"mg_id": {"type": "integer"}, "currency_code": {"type": "string", "description": "可不传；传入时必须等于设备当前币种"}, "cost_price": {"type": "number"}, "market_price": {"type": "number"}, "retail_price": {"type": "number"}}}]}}}}, "responses": {"200": {"description": "成功"}}}}
  },
  "components": {
    "securitySchemes": {
      "ManagementToken": {"type": "apiKey", "in": "header", "name": "token"},
      "MachineMac": {"type": "apiKey", "in": "header", "name": "mac"}
    },
    "schemas": {
      "Currency": {"type": "object", "properties": {"currency_code": {"type": "string", "example": "HKD"}, "currency_name": {"type": "string", "example": "港币"}, "currency_symbol": {"type": "string", "example": "HK$"}, "decimal_places": {"type": "integer", "example": 2}, "status": {"type": "integer", "enum": [1, 2]}, "is_default": {"type": "integer", "enum": [0, 1]}}},
      "CurrencyInput": {"allOf": [{"$ref": "#/components/schemas/Currency"}, {"type": "object", "required": ["currency_code", "currency_name", "decimal_places", "status"]}]},
      "CurrencyListResponse": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "data": {"type": "array", "items": {"$ref": "#/components/schemas/Currency"}}}},
      "CurrencyPriceInput": {"type": "object", "required": ["currency_code", "cost_price", "market_price", "retail_price"], "properties": {"currency_code": {"type": "string", "pattern": "^[A-Za-z]{3}$", "example": "HKD"}, "cost_price": {"type": "number", "minimum": 0}, "market_price": {"type": "number", "minimum": 0}, "retail_price": {"type": "number", "minimum": 0}}},
      "CoreCurrencyPrices": {"type": "object", "properties": {"currency_prices": {"type": "array", "items": {"$ref": "#/components/schemas/CurrencyPriceInput"}}, "cny_cost_price": {"type": "number"}, "cny_market_price": {"type": "number"}, "cny_retail_price": {"type": "number"}, "hkd_cost_price": {"type": "number"}, "hkd_market_price": {"type": "number"}, "hkd_retail_price": {"type": "number"}}},
      "CurrencySwitchInput": {"type": "object", "required": ["m_id", "currency_code"], "properties": {"m_id": {"type": "integer"}, "currency_code": {"type": "string", "example": "HKD"}}},
      "MachineSignedRequest": {"type": "object", "required": ["msg_id", "machine_id", "timestamp", "sign"], "properties": {"msg_id": {"type": "string"}, "machine_id": {"type": "string"}, "timestamp": {"type": "integer"}, "sign": {"type": "string"}}}
    }
  }
}
