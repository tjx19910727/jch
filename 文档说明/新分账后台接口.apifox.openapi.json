{
  "openapi": "3.0.3",
  "info": {
    "title": "嘉潮汇管理后台 - 新分账接口",
    "description": "新分账后台配置、分账订单查询、配置自检与测试环境模拟支付成功接口。导入 Apifox 后，请在环境中配置 baseUrl 和 token。所有接口均为 POST，请在 Header 中携带 token: {{token}}。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "{{baseUrl}}",
      "description": "Apifox 环境变量 baseUrl，例如 https://your-domain.com"
    }
  ],
  "security": [
    {
      "TokenAuth": []
    }
  ],
  "tags": [
    {
      "name": "新分账-分账账户",
      "description": "维护分账账户及账户管理人"
    },
    {
      "name": "新分账-收款渠道",
      "description": "配置哪些支付渠道需要参与新分账"
    },
    {
      "name": "新分账-收款策略配置",
      "description": "给收款策略配置默认分账账户及开关"
    },
    {
      "name": "新分账-分账策略",
      "description": "维护普通/设备出租/设备分账策略、明细、阶梯、设备绑定"
    },
    {
      "name": "新分账-分账订单",
      "description": "查询分账订单、导出、测试环境模拟支付成功"
    }
  ],
  "paths": {
    "/management/revenue.revenue_account/getList": {
      "post": {
        "tags": ["新分账-分账账户"],
        "summary": "分账账户列表",
        "description": "查询分账账户。account_name、account 支持模糊查询。",
        "operationId": "revenueAccountGetList",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueAccountListRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_account/getFind": {
      "post": {
        "tags": ["新分账-分账账户"],
        "summary": "分账账户详情",
        "description": "按条件查询单条分账账户，常用 ra_id。",
        "operationId": "revenueAccountGetFind",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueAccountFindRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_account/add": {
      "post": {
        "tags": ["新分账-分账账户"],
        "summary": "新增分账账户",
        "description": "新增分账账户。账户管理人 manager_id 必须存在、启用，且所属组织必须与 ao_id 一致。",
        "operationId": "revenueAccountAdd",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueAccountAddRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_account/update": {
      "post": {
        "tags": ["新分账-分账账户"],
        "summary": "修改分账账户",
        "description": "修改分账账户。除 ra_id 必填外，其余字段按需提交。",
        "operationId": "revenueAccountUpdate",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueAccountUpdateRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_account/del": {
      "post": {
        "tags": ["新分账-分账账户"],
        "summary": "删除分账账户",
        "description": "按 ra_id 删除分账账户。",
        "operationId": "revenueAccountDel",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueAccountDelRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_pay_channel/getList": {
      "post": {
        "tags": ["新分账-收款渠道"],
        "summary": "分账收款渠道列表",
        "description": "查询需要参与新分账的收款渠道配置。channel_name 支持模糊查询。",
        "operationId": "revenuePayChannelGetList",
        "requestBody": {"$ref": "#/components/requestBodies/RevenuePayChannelListRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_pay_channel/getFind": {
      "post": {
        "tags": ["新分账-收款渠道"],
        "summary": "分账收款渠道详情",
        "description": "按条件查询单条收款渠道配置，常用 rpc_id 或 pay_type。",
        "operationId": "revenuePayChannelGetFind",
        "requestBody": {"$ref": "#/components/requestBodies/RevenuePayChannelFindRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_pay_channel/add": {
      "post": {
        "tags": ["新分账-收款渠道"],
        "summary": "新增分账收款渠道",
        "description": "配置某订单支付类型需要参与新分账。pay_type 唯一。",
        "operationId": "revenuePayChannelAdd",
        "requestBody": {"$ref": "#/components/requestBodies/RevenuePayChannelAddRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_pay_channel/update": {
      "post": {
        "tags": ["新分账-收款渠道"],
        "summary": "修改分账收款渠道",
        "description": "修改收款渠道配置。除 rpc_id 必填外，其余字段按需提交。",
        "operationId": "revenuePayChannelUpdate",
        "requestBody": {"$ref": "#/components/requestBodies/RevenuePayChannelUpdateRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_pay_channel/del": {
      "post": {
        "tags": ["新分账-收款渠道"],
        "summary": "删除分账收款渠道",
        "description": "按 rpc_id 删除收款渠道配置。",
        "operationId": "revenuePayChannelDel",
        "requestBody": {"$ref": "#/components/requestBodies/RevenuePayChannelDelRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_payee_config/save": {
      "post": {
        "tags": ["新分账-收款策略配置"],
        "summary": "保存收款策略新分账配置",
        "description": "给收款策略配置默认分账账户及启用状态。若 sp_id 已存在则更新，否则新增。启用分账且支付渠道已开启时，default_ra_id 必填，且账户所属组织必须与收款策略组织一致。",
        "operationId": "revenuePayeeConfigSave",
        "requestBody": {"$ref": "#/components/requestBodies/RevenuePayeeConfigSaveRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_payee_config/getList": {
      "post": {
        "tags": ["新分账-收款策略配置"],
        "summary": "收款策略新分账配置列表",
        "description": "查询收款策略新分账配置。",
        "operationId": "revenuePayeeConfigGetList",
        "requestBody": {"$ref": "#/components/requestBodies/RevenuePayeeConfigListRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_payee_config/getFind": {
      "post": {
        "tags": ["新分账-收款策略配置"],
        "summary": "收款策略新分账配置详情",
        "description": "按条件查询单条收款策略新分账配置，常用 rpcfg_id 或 sp_id。",
        "operationId": "revenuePayeeConfigGetFind",
        "requestBody": {"$ref": "#/components/requestBodies/RevenuePayeeConfigFindRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_payee_config/checkConfig": {
      "post": {
        "tags": ["新分账-收款策略配置"],
        "summary": "新分账配置自检",
        "description": "检查启用渠道、未配置收款策略、默认账户异常、策略账户异常、出租策略异常、设备分账比例超限、阶梯异常等。",
        "operationId": "revenuePayeeConfigCheckConfig",
        "requestBody": {"$ref": "#/components/requestBodies/EmptyRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/getList": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "分账策略列表",
        "description": "查询分账策略组。rule_name 支持模糊查询。",
        "operationId": "revenueRuleGetList",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleListRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/getFind": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "分账策略详情",
        "description": "按条件查询单条分账策略，常用 rr_id。",
        "operationId": "revenueRuleGetFind",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleFindRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/add": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "新增分账策略",
        "description": "新增策略组。rule_mode：1普通分账，2设备出租，3设备分账。",
        "operationId": "revenueRuleAdd",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleAddRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/update": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "修改分账策略",
        "description": "修改策略组。除 rr_id 必填外，其余字段按需提交。",
        "operationId": "revenueRuleUpdate",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleUpdateRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/addItem": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "新增分账策略明细",
        "description": "新增策略接收方明细。设备出租模式不支持阶梯分账；设备分账固定比例合计不能超过100%。",
        "operationId": "revenueRuleAddItem",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleItemAddRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/updateItem": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "修改分账策略明细",
        "description": "修改策略接收方明细。除 rri_id 必填外，其余字段按需提交。",
        "operationId": "revenueRuleUpdateItem",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleItemUpdateRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/getItemList": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "分账策略明细列表",
        "description": "查询策略明细，常用 rr_id。",
        "operationId": "revenueRuleGetItemList",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleItemListRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/delItem": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "删除分账策略明细",
        "description": "按 rri_id 删除策略明细。",
        "operationId": "revenueRuleDelItem",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleItemDelRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/addTier": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "新增阶梯分账明细",
        "description": "给 calc_type=4 的策略明细配置阶梯。区间不能重叠，threshold_max 为空表示无上限。",
        "operationId": "revenueRuleAddTier",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleTierAddRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/updateTier": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "修改阶梯分账明细",
        "description": "修改阶梯区间。除 rrit_id 必填外，其余字段按需提交。",
        "operationId": "revenueRuleUpdateTier",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleTierUpdateRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/getTierList": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "阶梯分账明细列表",
        "description": "查询阶梯明细，常用 rri_id。",
        "operationId": "revenueRuleGetTierList",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleTierListRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/delTier": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "删除阶梯分账明细",
        "description": "按 rrit_id 删除阶梯明细。",
        "operationId": "revenueRuleDelTier",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleTierDelRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/bindMachine": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "绑定设备分账策略",
        "description": "将策略绑定到设备。同一设备不能绑定多个同类型启用分账策略。",
        "operationId": "revenueRuleBindMachine",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleBindMachineRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/getMachineList": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "设备策略绑定列表",
        "description": "查询设备绑定的分账策略。",
        "operationId": "revenueRuleGetMachineList",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleMachineListRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_rule/unbindMachine": {
      "post": {
        "tags": ["新分账-分账策略"],
        "summary": "解绑设备分账策略",
        "description": "按 rrm_id 删除设备策略绑定。",
        "operationId": "revenueRuleUnbindMachine",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueRuleUnbindMachineRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_order/getList": {
      "post": {
        "tags": ["新分账-分账订单"],
        "summary": "分账订单列表",
        "description": "查询分账订单。账户管理人仅可见自己 manager_id 的分账订单，审核权限账号可查看更大范围。",
        "operationId": "revenueOrderGetList",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueOrderListRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_order/getFind": {
      "post": {
        "tags": ["新分账-分账订单"],
        "summary": "分账订单详情",
        "description": "按条件查询单条分账订单，常用 ro_id 或 order_id。",
        "operationId": "revenueOrderGetFind",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueOrderFindRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_order/getDetail": {
      "post": {
        "tags": ["新分账-分账订单"],
        "summary": "分账订单聚合详情",
        "description": "查询分账订单及关联销售订单、订单明细、同订单全部分账记录、退款记录。",
        "operationId": "revenueOrderGetDetail",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueOrderFindRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_order/export": {
      "post": {
        "tags": ["新分账-分账订单"],
        "summary": "导出分账订单",
        "description": "按筛选条件导出分账订单报表。",
        "operationId": "revenueOrderExport",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueOrderListRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    },
    "/management/revenue.revenue_order/mockPaySuccess": {
      "post": {
        "tags": ["新分账-分账订单"],
        "summary": "测试环境模拟支付成功",
        "description": "仅 env('CglPay.is_test') 为 true 时可用。用于绕过真实支付，触发新分账预计算、结算 status=0/2 的新分账单，并将订单置为 pay_status=3。不触发完整出货/MQ/通知。",
        "operationId": "revenueOrderMockPaySuccess",
        "requestBody": {"$ref": "#/components/requestBodies/RevenueOrderMockPaySuccessRequest"},
        "responses": {"200": {"$ref": "#/components/responses/CommonSuccess"}}
      }
    }
  },
  "components": {
    "securitySchemes": {
      "TokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "token",
        "description": "管理后台登录 token。Apifox 环境变量填写 {{token}}，请求头示例：token: {{token}}"
      }
    },
    "requestBodies": {
      "EmptyRequest": {"required": false, "content": {"application/json": {"schema": {"type": "object"}}}},
      "RevenueAccountListRequest": {"required": false, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenueAccountListRequest"}, "example": {"pageNum": 20, "account_name": "默认", "status": 1}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RevenueAccountListRequest"}}}},
      "RevenueAccountFindRequest": {"required": false, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenueAccountFindRequest"}, "example": {"ra_id": 1}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RevenueAccountFindRequest"}}}},
      "RevenueAccountAddRequest": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenueAccountAddRequest"}, "example": {"ao_id": 1, "manager_id": 10, "account_name": "A组织默认余额账户", "account_type": "balance", "account": "A_BALANCE", "bill_account": "A_BALANCE", "status": 1}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RevenueAccountAddRequest"}}}},
      "RevenueAccountUpdateRequest": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenueAccountUpdateRequest"}, "example": {"ra_id": 1, "account_name": "A组织默认余额账户-更新", "status": 1}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RevenueAccountUpdateRequest"}}}},
      "RevenueAccountDelRequest": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenueAccountDelRequest"}, "example": {"ra_id": 1}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RevenueAccountDelRequest"}}}},
      "RevenuePayChannelListRequest": {"required": false, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenuePayChannelListRequest"}, "example": {"pageNum": 20, "channel_name": "微信", "status": 1}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RevenuePayChannelListRequest"}}}},
      "RevenuePayChannelFindRequest": {"required": false, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenuePayChannelFindRequest"}, "example": {"rpc_id": 1}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RevenuePayChannelFindRequest"}}}},
      "RevenuePayChannelAddRequest": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenuePayChannelAddRequest"}, "example": {"pay_type": 1, "payee_type": 1, "channel_name": "微信支付", "status": 1}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RevenuePayChannelAddRequest"}}}},
      "RevenuePayChannelUpdateRequest": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenuePayChannelUpdateRequest"}, "example": {"rpc_id": 1, "channel_name": "微信支付", "status": 1}}, "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/RevenuePayChannelUpdateRequest"}}}},
