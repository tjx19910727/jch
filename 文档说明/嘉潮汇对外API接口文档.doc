    &quot;notify_url&quot;: &quot;http://www.baidu.com&quot;,
    &quot;order_detail&quot;: &quot;{\&quot;63\&quot;:{\&quot;quantity\&quot;:1,\&quot;item_price\&quot;:100,\&quot;discount_amount\&quot;:1,\&quot;charge_amount\&quot;:99,\&quot;type\&quot;:\&quot;sale\&quot;,\&quot;out_port\&quot;:1},\&quot;87\&quot;:{\&quot;quantity\&quot;:2,\&quot;item_price\&quot;:50,\&quot;discount_amount\&quot;:3,\&quot;charge_amount\&quot;:97,\&quot;type\&quot;:\&quot;sale\&quot;,\&quot;out_port\&quot;:2}}&quot;
